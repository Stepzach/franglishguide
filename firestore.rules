rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function aTableSignedIn() { return request.auth != null; }
    function aTableKnownPlace(place) {
      return place in ['le-phalsbourg','la-cantine-lourmel','kome-kome','season-marais','land-and-monkeys','adulis','carbonis','maker-jeuneurs','los-mochis'];
    }
    match /atablePlaces/{place}/likes/{uid} {
      allow read: if aTableKnownPlace(place);
      allow create: if aTableKnownPlace(place) && aTableSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow delete: if aTableSignedIn() && request.auth.uid == uid;
      allow update: if false;
    }
    match /atablePlaces/{place}/comments/{comment} {
      allow read: if aTableKnownPlace(place);
      allow create: if aTableKnownPlace(place) && aTableSignedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow delete: if aTableSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
  }
}
